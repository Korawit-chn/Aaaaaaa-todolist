C4Container
title Container diagram for ICT To Do List

Person(student, "Student", "The main user who manages the task list, views assignments, and tracks submission status.")
Person(instructor, "Instructor", "Views their own teaching related tasks and monitors a high level view of assignment deadlines for the courses they teach, but the instructor does not see student private tasks.")
Person(admin, "System Administrator", "Manages system configuration, supports user accounts, and monitors sync health.")

System_Ext(mycourses, "MyCourses", "External ICT e learning system providing course, assignment, and submission data.")

Container_Boundary(ict_boundary, "ICT To Do List") {
    Container(web_app, "Web App", "React", "Browser-based single page application for task management")
    Container(mobile_app, "Mobile App", "Flutter", "Cross-platform mobile application for iOS and Android")
    Container(web_api, "Web API", "Python, FastAPI", "REST API providing endpoints for task CRUD and sync operations")
    ContainerDb(database, "Database", "PostgreSQL", "Stores user profiles, tasks, sync settings, and sync history")
    Container(mycourses_connector, "MyCourses Connector", "Python", "Integration module for calling MyCourses web services")
}

Rel(student, web_app, "Manages personal tasks and tracks course work", "HTTPS")
Rel(student, mobile_app, "Manages personal tasks and tracks course work", "HTTPS")
Rel(instructor, web_app, "Views teaching-related tasks and monitors deadlines", "HTTPS")
Rel(instructor, mobile_app, "Views teaching-related tasks and monitors deadlines", "HTTPS")
Rel(admin, web_app, "System configuration and sync monitoring", "HTTPS")

Rel(web_app, web_api, "Makes API calls", "JSON/HTTPS")
Rel(mobile_app, web_api, "Makes API calls", "JSON/HTTPS")

Rel(web_api, database, "Reads and writes data", "SQL")
Rel(web_api, mycourses_connector, "Calls for sync", "Internal")

Rel(mycourses_connector, mycourses, "Retrieves data", "JSON/HTTPS")

UpdateLayoutConfig($c4ShapeInRow="3")